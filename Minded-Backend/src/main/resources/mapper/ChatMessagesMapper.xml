<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yz.minded.mapper.ChatMessagesMapper">

    <resultMap id="BaseResultMap" type="com.yz.minded.pojo.ChatMessages">
            <id property="chatId" column="chat_id" jdbcType="BIGINT"/>
            <result property="senderId" column="sender_id" jdbcType="BIGINT"/>
            <result property="receiverId" column="receiver_id" jdbcType="BIGINT"/>
            <result property="message" column="message" jdbcType="VARCHAR"/>
            <result property="timestamp" column="timestamp" jdbcType="TIMESTAMP"/>
            <result property="readStatus" column="read_status" jdbcType="TINYINT"/>
    </resultMap>

    <sql id="Base_Column_List">
        chat_id,sender_id,receiver_id,
        message,timestamp,read_status
    </sql>
</mapper>
